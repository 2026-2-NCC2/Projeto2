# API Supabase: somente no servidor, independente do backend MySQL/MariaDB.
# Preencha no .env privado ou nas variaveis do servidor. Nunca use VITE_ ou
# copie a Secret Key para frontend, logs ou arquivos versionados.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Preparacao PostgreSQL/Supabase, independente do backend MariaDB existente.
# Nenhuma credencial real deve ser versionada. Preencha somente no ambiente privado.
# Use os parametros PostgreSQL do painel Supabase (conexao direta ou pooler).
# A chave de API Supabase nao substitui a senha PostgreSQL.
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=

# Limite de conexoes e timeouts em milissegundos; todos devem ser positivos.
PGPOOL_MAX=10
PGCONNECT_TIMEOUT_MS=10000
PGIDLE_TIMEOUT_MS=30000

# Opcional: caminho do certificado CA PEM fornecido pelo provedor.
# Vazio usa as CAs confiaveis do Node. TLS >= 1.2 e certificado/hostname
# sempre verificados; nao desative a verificacao com NODE_TLS_REJECT_UNAUTHORIZED.
PGSSLROOTCERT=

# db-postgres.js nao carrega .env automaticamente nem usa DATABASE_URL,
# PGSSLMODE ou URLs que possam sobrescrever a configuracao TLS.
# Uso futuro (nao integrado ao server.js): carregar dotenv explicitamente,
# const { criarPoolPostgres } = require('./db-postgres');
# const pool = criarPoolPostgres();
# Importar o modulo e criar o pool nao abrem conexoes.
# query()/connect() abrem conexoes: tratar suas rejeicoes com try/catch,
# liberar clientes de connect() em finally e chamar pool.end() ao encerrar.
# Nao copiar estas variaveis para o inicializador MariaDB isolado.
